@page
@model LoginModel
@{
    Layout = null;
    var hasFailedLogin = Request.Query["failed"] == "1";
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Logga in - FamilyHub</title>
    <link rel="stylesheet" href="/app.css" />
    <link rel="stylesheet" href="/auth.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    <main class="auth-page">
        <section class="auth-card" aria-labelledby="login-heading">
            <div class="auth-icon" aria-hidden="true"><i class="bi bi-house-heart"></i></div>
            <h1 id="login-heading">FamilyHub</h1>
            <p class="auth-description">Logga in för att öppna familjens kalender.</p>
            @if (hasFailedLogin)
            {
                <p class="auth-error" role="alert">Lösenordet stämmer inte. Försök igen.</p>
            }
            <form method="post" action="/auth/login">
                @Html.AntiForgeryToken()
                <label for="Password">Familjens lösenord</label>
                <input id="Password"
                       name="Password"
                       type="password"
                       autocomplete="current-password"
                       required
                       autofocus />
                <button type="submit">Logga in</button>
            </form>
        </section>
    </main>
</body>
</html>
