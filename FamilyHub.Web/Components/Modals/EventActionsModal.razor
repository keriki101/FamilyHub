@using System.Globalization
@using FamilyHub.Web.Services

<BaseModal IsOpen="@IsOpen" OnClose="Close">
    @if (Event is not null)
    {
        <div class="modal-header">
            <h2>@(ConfirmingDelete ? "Ta bort event?" : Event.Title)</h2>
            <button type="button" class="close-btn" aria-label="Stäng" @onclick="Close">✕</button>
        </div>

        @if (ConfirmingDelete)
        {
            <p>@(Event.RecurrenceSeriesId is null ? "Eventet tas bort permanent." : "Ta bort bara detta tillfälle eller hela den återkommande serien?")</p>
            <div class="event-actions">
                @if (Event.RecurrenceSeriesId is not null)
                {
                    <button type="button" class="save-btn delete-btn" disabled="@IsDeleting" @onclick="Delete">
                        @(IsDeleting ? "Sparar..." : "Ta bort detta tillfälle")
                    </button>
                    <button type="button" class="save-btn delete-btn" disabled="@IsDeleting" @onclick="DeleteSeries">
                        @(IsDeleting ? "Sparar..." : "Ta bort hela serien")
                    </button>
                }
                else
                {
                    <button type="button" class="save-btn delete-btn" disabled="@IsDeleting" @onclick="Delete">
                        @(IsDeleting ? "Sparar..." : "Ta bort")
                    </button>
                }
                <button type="button" class="save-btn secondary-btn" disabled="@IsDeleting" @onclick="() => ConfirmingDelete = false">Avbryt</button>
            </div>
            @if (!string.IsNullOrEmpty(DeleteError))
            {
                <p class="validation-message" role="alert">@DeleteError</p>
            }
        }
        else
        {
            <p>@Event.Start.ToString("dddd d MMMM, HH:mm", SwedishCulture) – @Event.End.ToString("HH:mm")</p>
            <div class="event-actions">
                @if (Event.RecurrenceSeriesId is not null)
                {
                    <button type="button" class="save-btn" @onclick="Edit">Redigera detta tillfälle</button>
                    <button type="button" class="save-btn" @onclick="EditSeries">Redigera hela serien</button>
                }
                else
                {
                    <button type="button" class="save-btn" @onclick="Edit">Redigera</button>
                }
                <button type="button" class="save-btn secondary-btn" @onclick="Duplicate">Duplicera</button>
                <button type="button" class="save-btn delete-btn" @onclick="BeginDeleteConfirmation">Ta bort</button>
            </div>
        }
    }
</BaseModal>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public Event? Event { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnEdit { get; set; }

    [Parameter]
    public EventCallback OnDuplicate { get; set; }

    [Parameter]
    public Func<Task<SaveOperationResult>> OnDelete { get; set; } = default!;

    [Parameter]
    public EventCallback OnEditSeries { get; set; }

    [Parameter]
    public Func<Task<SaveOperationResult>> OnDeleteSeries { get; set; } = default!;

    private static readonly CultureInfo SwedishCulture = CultureInfo.GetCultureInfo("sv-SE");
    private bool ConfirmingDelete;
    private bool IsDeleting;
    private string? DeleteError;

    private async Task Edit()
    {
        ConfirmingDelete = false;
        await OnEdit.InvokeAsync();
    }

    private async Task Duplicate()
    {
        ConfirmingDelete = false;
        await OnDuplicate.InvokeAsync();
    }

    private async Task EditSeries()
    {
        ConfirmingDelete = false;
        await OnEditSeries.InvokeAsync();
    }

    private async Task Delete()
    {
        await DeleteAsync(OnDelete);
    }

    private async Task DeleteSeries()
    {
        await DeleteAsync(OnDeleteSeries);
    }

    private async Task Close()
    {
        if (IsDeleting)
        {
            return;
        }

        ConfirmingDelete = false;
        DeleteError = null;
        await OnClose.InvokeAsync();
    }

    private async Task DeleteAsync(Func<Task<SaveOperationResult>> delete)
    {
        if (IsDeleting)
        {
            return;
        }

        IsDeleting = true;
        DeleteError = null;
        try
        {
            var result = await delete();
            if (result.Succeeded)
            {
                ConfirmingDelete = false;
            }
            else
            {
                DeleteError = result.ErrorMessage;
            }
        }
        finally
        {
            IsDeleting = false;
        }
    }

    private void BeginDeleteConfirmation()
    {
        DeleteError = null;
        ConfirmingDelete = true;
    }
}
